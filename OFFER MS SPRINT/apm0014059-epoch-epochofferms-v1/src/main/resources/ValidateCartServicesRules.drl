rule "Cart Product Genre Base Present/Not Present - service rule "
    salience 1000

    when
        CouponOffersRequest($cartContext: cartContext);
        CartContexts($cartProducts: cartProducts) from $cartContext;
        eval($cartProducts != null && !$cartProducts.isEmpty() && genreBaseProductCodes != null && !genreBaseProductCodes.isEmpty() && CollectionUtils.containsAny(genreSpecificRuleCohortList, contractIndicator))
    then
        log.info("Executing rule: Cart Product Genre Base Present/Not Present  - service rule");
        boolean isGenreBaseProductPresent = false;
        for (Object objGenreBaseProductCode : genreBaseProductCodes) {
            String genreBaseProductCode = (String) objGenreBaseProductCode;
           //System.out.println("Checking genreBaseProductCode: " + genreBaseProductCode);
            for (Object objCartProduct : $cartProducts) {
                CartProduct cartProduct = (CartProduct) objCartProduct;
               //System.out.println("Checking cartProduct: " + cartProduct.getProductCode());
                if(genreBaseProductCode.equalsIgnoreCase(cartProduct.getProductCode())) {
                    if ("Add".equalsIgnoreCase(cartProduct.getAction()) || "NoChange".equalsIgnoreCase(cartProduct.getAction())) {
                        isGenreBaseProductPresent = true;
                       //System.out.println("Genre base product is present with action: " + cartProduct.getAction());
                    }
                }
            }
        }
        if(!isGenreBaseProductPresent && contractIndicator.contains("GENRE")){
           //System.out.println("isGenreBaseProductPresent====> "+isGenreBaseProductPresent);
           //System.out.println("Genre base product is not present");
           //System.out.println("messageDetails.size() ====>" + messageDetails.size());
            messageDetails.add(createMessageDetail("MISSING_BASE", "Must Select Genre Base to proceed", "ERROR"));
           //System.out.println("messageDetails.size() after adding ====>" + messageDetails.size());
            cartItems.clear();
            drools.halt();
        }else{
       //System.out.println("Inside Else logic - GenreBaseProduct is present");
        // adding the existing cart products to cartItems

        for (Object obj : $cartProducts) {
            CartProduct cartProduct = (CartProduct) obj;
            CartItems $cartItem = new CartItems();
            $cartItem.setProductCode(cartProduct.getProductCode());

             if (cartProduct.getPromotions() != null) {
                setPromos(cartProduct, $cartItem);
             }
             $cartItem.setAction(cartProduct.getAction());
            cartItems.add($cartItem);
            }
        }
        log.info("Finished executing rule: Cart Product Genre Base Present/Not Present  - service rule");
    end;

rule "Cart Product Base Present/Not Present - service rule "
salience 995
    when
        CouponOffersRequest($cartContext: cartContext);
        CartContexts($cartProducts: cartProducts) from $cartContext;
        eval($cartProducts != null && !$cartProducts.isEmpty() && baseProductCodes != null && !baseProductCodes.isEmpty() && !CollectionUtils.containsAny(genreSpecificRuleCohortList, contractIndicator) && CollectionUtils.containsAny(commonRuleCohortList, contractIndicator))
    then
        log.info("Executing rule: Cart Product Genre Base Present/Not Present  - service rule");
        boolean isBaseProductPresent = false;
            for (Object objBaseProductCode : baseProductCodes) {
                String baseProductCode = (String) objBaseProductCode;
               //System.out.println("Checking baseProductCode: " + baseProductCode);
                for (Object objCartProduct : $cartProducts) {
                    CartProduct cartProduct = (CartProduct) objCartProduct;
                   //System.out.println("Checking cartProduct: " + cartProduct.getProductCode());
                    if (baseProductCode.equalsIgnoreCase(cartProduct.getProductCode())) {
                        if ("Add".equalsIgnoreCase(cartProduct.getAction()) || "NoChange".equalsIgnoreCase(cartProduct.getAction())) {
                            isBaseProductPresent = true;
                           //System.out.println("Base product is present with action: " + cartProduct.getAction());
                        }
                    }
                }
            }

            if (standaloneAddonsProductCodes != null && !standaloneAddonsProductCodes.isEmpty() && contractIndicator.contains("non-contract")) {
                for (Object stdAloneProductCode : standaloneAddonsProductCodes) {
                    String stdPrdCode = (String) stdAloneProductCode;
                    for (Object objCartProduct : $cartProducts) {
                        CartProduct cartProduct = (CartProduct) objCartProduct;
                        if (stdPrdCode.equalsIgnoreCase(cartProduct.getProductCode())) {
                            if ("Add".equalsIgnoreCase(cartProduct.getAction()) || "NoChange".equalsIgnoreCase(cartProduct.getAction())) {
                                isBaseProductPresent = true;
                               //System.out.println("StandAlone product is present with action: " + cartProduct.getAction());
                            }
                        }
                    }
                }
            }
            if(!isBaseProductPresent){
               //System.out.println("isBaseProductPresent====> "+isBaseProductPresent);
               //System.out.println("base product is not present");
               //System.out.println("messageDetails.size() ====>" + messageDetails.size());
                messageDetails.add(createMessageDetail("MISSING_BASE", "Must Select Base Package to proceed", "ERROR"));
               //System.out.println("messageDetails.size() after adding ====>" + messageDetails.size());
                drools.halt();
            }else{
           //System.out.println("Inside Else logic - BaseProduct is present");
            // adding the existing cart products to cartItems

            for (Object obj : $cartProducts) {
                CartProduct cartProduct = (CartProduct) obj;
                CartItems $cartItem = new CartItems();
                $cartItem.setProductCode(cartProduct.getProductCode());

                 if (cartProduct.getPromotions() != null) {
                    setPromos(cartProduct, $cartItem);
                 }
                 $cartItem.setAction(cartProduct.getAction());
                cartItems.add($cartItem);
                }
            }
            log.info("Finished executing rule: Cart Product Base Present/Not Present  - service rule");
        end;


rule "Cart Product Services -Same Product Group Rule Two Add not allowed"
salience 990
    when
        CouponOffersRequest($cartContext: cartContext);
        CartContexts($cartProducts: cartProducts) from $cartContext;
        $productList : List() from collect(CartProduct(productCode != null && action == "Add") from $cartProducts);
        eval(!compRankingBillingEnabled && $productList.size() >1 && getGroupingByProductGrpMap !=null && !getGroupingByProductGrpMap.isEmpty() && CollectionUtils.containsAny(commonRuleCohortList, contractIndicator));
    then
       log.info("Executing rule:Same Product Group Rule Two Add not allowed");
        List<String> productCodesInList = getAllProductCodesFromCart($productList);
       //System.out.println("productCodesInList: " + productCodesInList);
        Map<String, List<String>> groupingByProductGrpMaps = getGroupingByProductGrpMap;
        for (Map.Entry<String, List<String>> entry : groupingByProductGrpMaps.entrySet()) {
            String productGroup = entry.getKey();
           //System.out.println("productGroup: " + productGroup);
            List<String> requiredProducts = entry.getValue();
           //System.out.println("requiredProducts: " + requiredProducts);

            if (productGroup.equalsIgnoreCase("MVPXPEACOCK")) {
                continue; // Skip this group No Multiple Add Products from same group check required for MVPXPEACOCK
            }
            List<String> productCodes = requiredProducts.stream()
                .filter(productCodesInList::contains)
                .collect(Collectors.toList());
           //System.out.println("productCodes: " + productCodes);
            if (productCodes.size() >= 2) {
                messageDetails.add(createMessageDetail("MULTIPLE_ADDPRODUCTS_SAMEGROUP", "Multiple Products cannot be added from the same group ( " + productGroup + ")", "ERROR"));
                drools.halt();
            }
        }
        log.info("Finished executing rule:Same Product Group Rule Two Add not allowed");
    end;


rule "Cart Product Services -Remove another product if same product group product is added"
salience 985
    when
        CouponOffersRequest($cartContext: cartContext);
        CartContexts($cartProducts: cartProducts) from $cartContext;
        $productList : List() from collect(CartProduct(productCode != null && (action == "Add" || action =="NoChange")) from $cartProducts);
        eval(compRankingBillingEnabled && $productList.size() >1 && getGroupingByProductGrpMap !=null && !getGroupingByProductGrpMap.isEmpty() && CollectionUtils.containsAny(commonRuleCohortList, contractIndicator));
    then
       log.info("Executing rule:Same Product Group Rule Two Add not allowed");
        List<String> productCodesInList = (List<String>) cartItems.stream().filter(item -> item instanceof CartItems).map(item -> ((CartItems) item).getProductCode()).collect(Collectors.toList());
       //System.out.println("productCodesInList: " + productCodesInList);
        List<CartItems> cartItemsToRemove = new ArrayList<>();
        Map<String, List<String>> groupingByProductGrpMaps = getGroupingByProductGrpMap;
        for (Map.Entry<String, List<String>> entry : groupingByProductGrpMaps.entrySet()) {
            String productGroup = entry.getKey();
           //System.out.println("productGroup: " + productGroup);
            List<String> requiredProducts = entry.getValue();
           //System.out.println("requiredProducts: " + requiredProducts);

            if (productGroup.equalsIgnoreCase("MVPXPEACOCK")) {
                continue; // Skip this group No Multiple Add Products from same group check required for MVPXPEACOCK
            }
            List<String> productCodes = requiredProducts.stream().filter(productCodesInList::contains).collect(Collectors.toList());
           //System.out.println("productCodes: " + productCodes);
            boolean allAddPresent  = cartItems.stream().filter(item -> item instanceof CartItems && requiredProducts.contains(((CartItems) item).getProductCode())).allMatch(item -> "Add".equalsIgnoreCase(((CartItems) item).getAction()));
            boolean allNoChangePresent  = cartItems.stream().filter(item -> item instanceof CartItems && requiredProducts.contains(((CartItems) item).getProductCode())).allMatch(item -> "NoChange".equalsIgnoreCase(((CartItems) item).getAction()));
           //System.out.println("allAddPresent: " + allAddPresent);
           //System.out.println("allNoChangePresent: " + allNoChangePresent);
            if (productCodes.size() >= 2 && (allAddPresent || allNoChangePresent)) {
                for (Object obj : cartItems) {
                    CartItems cartItem = (CartItems) obj;
                    if (productCodes.get(1).equalsIgnoreCase(cartItem.getProductCode()) && "Add".equalsIgnoreCase(cartItem.getAction())) {
                       cartItemsToRemove.add(cartItem);
                    }else if (productCodes.get(1).equalsIgnoreCase(cartItem.getProductCode()) && "NoChange".equalsIgnoreCase(cartItem.getAction())) {
                        cartItem.setAction("Remove");
                        cartItem.setValidationMessage(productCodeWithNameMap.get(cartItem.getProductCode()) + " is removed because another product from same group is added in the cart");
                    }
                }
            }

            if (cartItemsToRemove.size() > 0){
                for (CartItems itemToRemove : cartItemsToRemove) {
                    cartItems.remove(itemToRemove);
                }
            }
        }
        log.info("Finished executing rule:Remove another product if same product group product is added");
    end;

rule "Cart Product Services -Peacock"
salience 980
    when
        CouponOffersRequest($cartContext: cartContext);
        CartContexts($cartProducts: cartProducts) from $cartContext;
        $productList : List() from collect(CartProduct(productCode != null) from $cartProducts);
        eval(cartItems.size() > 0 && $productList.size() >1 && peacockProductsCondition !=null && !peacockProductsCondition.isEmpty() && CollectionUtils.containsAny(commonRuleCohortList, contractIndicator));
    then
       log.info("Cart Product Services -Peacock");
        List<String> productCodesInList = getAllProductCodesFromCart($productList);
        List<String> productCodesInListWithAdd = getAllProductCodesFromCartWithAction($productList, "Add");
       //System.out.println("productCodesInList: " + productCodesInList);
        Map<String, List<String>> peacockProductsConditionMaps = peacockProductsCondition;
        List<CartItems> cartItemsToRemove = new ArrayList<>();
        for (Map.Entry<String, List<String>> entry : peacockProductsConditionMaps.entrySet()) {
            String key = entry.getKey();
           //System.out.println("key: " + key);
            List<String> requiredProducts = entry.getValue();
           //System.out.println("requiredProductsFromMap: " + requiredProducts);

            boolean keyInListWithAdd = false;
            boolean keyInListWithRemove = false;
            boolean keyInListWithNoChange = false;
            for (Object obj : cartItems) {
                CartItems cartItem = (CartItems) obj;
                if (key.equalsIgnoreCase(cartItem.getProductCode()) && "Add".equalsIgnoreCase(cartItem.getAction())) {
                    keyInListWithAdd = true;
                    break;
                }
                if (key.equalsIgnoreCase(cartItem.getProductCode()) && "Remove".equalsIgnoreCase(cartItem.getAction())) {
                    keyInListWithRemove = true;
                    break;
                }
                if (key.equalsIgnoreCase(cartItem.getProductCode()) && "NoChange".equalsIgnoreCase(cartItem.getAction())) {
                    keyInListWithNoChange = true;
                    break;
                }
            }
            boolean requiredProductsMissing = requiredProducts.stream().noneMatch(productCodesInList::contains);
           //System.out.println("keyInListWithAdd: " + keyInListWithAdd);
           //System.out.println("keyInListWithRemove: " + keyInListWithRemove);
           //System.out.println("requiredProductsMissing: " + requiredProductsMissing);
            if (keyInListWithAdd && requiredProductsMissing) {
                // Skip processing this key
                continue;
            }
            boolean isAnyNonRequiredProductInCartWithAdd = requiredProducts.stream().anyMatch(productCodesInListWithAdd::contains);
           //System.out.println("isAnyNonRequiredProductInCartWithAdd: " + isAnyNonRequiredProductInCartWithAdd);
           //System.out.println("requiredProducts: " + requiredProducts);
            List<String> productCodes = requiredProducts.stream().filter(productCodesInList::contains).collect(Collectors.toList());
           //System.out.println("productCodes: " + productCodes);
            if (productCodes.size() >= 2  && !productCodesInList.contains(key)) {
                CartItems $cartItem = new CartItems();
                $cartItem.setProductCode(key);
                $cartItem.setAction("Change");
                cartItems.add($cartItem);
                for (Object obj : cartItems) {
                    CartItems cartItem = (CartItems) obj;
                        if (productCodes.contains(cartItem.getProductCode())) {
                           //System.out.println("Removing cartItem: " + cartItem.getProductCode());
                            cartItemsToRemove.add(cartItem);
                        }
                    }
                    //Add on purpose to productCodesInList to avoid adding same productCode again
                    productCodesInList.add(key);
            }else if(productCodesInList.contains(key) && keyInListWithAdd){
                for (Object obj : cartItems) {
                    CartItems cartItem = (CartItems) obj;
                    if(requiredProducts.contains(cartItem.getProductCode()) && !cartItem.getAction().equalsIgnoreCase("Add")){
                       //System.out.println("Removing cartItem: " + cartItem.getProductCode());
                        tempProductCodes.add(cartItem.getProductCode());
                        cartItemsToRemove.add(cartItem);
                    }else if(requiredProducts.contains(cartItem.getProductCode()) && cartItem.getAction().equalsIgnoreCase("Add")){
                       //System.out.println("Setting action to Remove for cartItem: " + cartItem.getProductCode());
                        tempProductCodes.add(cartItem.getProductCode());
                        cartItem.setAction("Remove");
                    }

                    if(key.equalsIgnoreCase(cartItem.getProductCode()) && keyInListWithAdd && !isAnyNonRequiredProductInCartWithAdd){
                       //System.out.println("Setting action to Change for cartItem: " + cartItem.getProductCode());
                        cartItem.setAction("Change");
                    }
                }
            }else if(productCodesInList.contains(key) && keyInListWithRemove && productCodes.size() > 0){
                for (Object obj : cartItems) {
                    CartItems cartItem = (CartItems) obj;
                    if(key.equalsIgnoreCase(cartItem.getProductCode())){
                        cartItemsToRemove.add(cartItem);
                    }else if(requiredProducts.contains(cartItem.getProductCode()) && cartItem.getAction().equalsIgnoreCase("Add")){
                       //System.out.println("Setting action to Change for cartItem: " + cartItem.getProductCode());
                        tempProductCodes.add(cartItem.getProductCode());
                        cartItem.setAction("Change");
                    }
                }
            }else if(productCodesInList.contains(key) && keyInListWithNoChange && productCodes.size() > 0){
                for (Object obj : cartItems) {
                    CartItems cartItem = (CartItems) obj;
                    if(key.equalsIgnoreCase(cartItem.getProductCode())){
                        cartItemsToRemove.add(cartItem);
                    }else if(requiredProducts.contains(cartItem.getProductCode()) && cartItem.getAction().equalsIgnoreCase("Add")){
                       //System.out.println("Setting action to Change for cartItem: " + cartItem.getProductCode());
                        tempProductCodes.add(cartItem.getProductCode());
                        cartItem.setAction("Change");
                    }
                }
            }
        }

        // Remove the cartItems that are in cartItemsToRemove
        for (CartItems itemToRemove : cartItemsToRemove) {
            tempProductCodes.add(itemToRemove.getProductCode());
            cartItems.remove(itemToRemove);
            if(svodProductsMaps != null && svodProductsMaps.keySet().contains(itemToRemove.getProductCode())){
                List<String> relatedProducts = (List<String>) svodProductsMaps.get(itemToRemove.getProductCode());
                for (Object objCartItem : cartItems) {
                     if (objCartItem instanceof CartItems) {
                        CartItems cartItem = (CartItems) objCartItem;
                        if(relatedProducts.contains(cartItem.getProductCode())){
                            cartItem.setAction("Remove");
                            cartItem.setValidationMessage(productCodeWithNameMap.get(cartItem.getProductCode()) + " is removed because "
                                +productCodeWithNameMap.get(itemToRemove.getProductCode()) +" is removed from the cart");
                        }
                     }
                }
            }
           //System.out.println("Removed cartItem: " + itemToRemove.getProductCode());
        }
        log.info("Cart Product Services -Peacock");
    end;

rule "Cart Product SVOD service rule"
salience 970
     when
        CouponOffersRequest($cartContext: cartContext); CartContexts($cartProducts: cartProducts) from $cartContext;
        $product: CartProduct(productCode != null && svodProductsMaps != null && svodProductsMaps.keySet().contains(productCode)) from $cartProducts
        eval(cartItems.size() > 0 && CollectionUtils.containsAny(commonRuleCohortList, contractIndicator) && !contractIndicator.contains("non-contract"));
     then
        log.info("Executing rule: Cart Product SVOD service rule");
       //System.out.println("tempProductCodes before processing: " + tempProductCodes);
        if(tempProductCodes != null && !tempProductCodes.isEmpty() && tempProductCodes.contains($product.getProductCode())){
           //System.out.println("Skipping processing for productCode: " + $product.getProductCode() + " as it's already processed in Peacock rule");
            return;
        }
       //System.out.println("$productCode =====> "+$product.getProductCode() + " Action ===> "+$product.getAction() + " svodProducts ====> "+svodProductsMaps.get($product.getProductCode()));
        boolean toSkip = false;
        for (Object obj : cartItems) {
            if (obj instanceof CartItems) {
            CartItems cartItem = (CartItems) obj;
                //This logic is to check duplicate productCode in cartItems
                if (svodProductsMaps.get($product.getProductCode()) != null && ((List<String>) svodProductsMaps.get($product.getProductCode())).contains(cartItem.getProductCode())) {
                    List<String> productCodes = (List<String>) svodProductsMaps.get($product.getProductCode());
                   //System.out.println("cartItem->code ========> "+cartItem.getProductCode());
                   //System.out.println("cartItem->action ========> "+cartItem.getAction());
                   //System.out.println("productCodes ========> "+productCodes);
                    if(!cartItem.getAction().equalsIgnoreCase("Remove") && $product.getAction().equalsIgnoreCase("Remove") ){
                     for (String productCode : productCodes) {
                        if(productCode.equalsIgnoreCase(cartItem.getProductCode())){
                             cartItem.setAction("Remove");
                             cartItem.setValidationMessage(productCodeWithNameMap.get((String) productCode) + " is removed because "
                                    +productCodeWithNameMap.get($product.getProductCode()) +" is being removed from the cart");
                        }
                     }
                    }else if(cartItem.getAction().equalsIgnoreCase("Remove") && !$product.getAction().equalsIgnoreCase("Remove")){
                        for (String productCode : productCodes) {
                            if(productCode.equalsIgnoreCase(cartItem.getProductCode())){
                                cartItem.setAction("Add");
                                cartItem.setValidationMessage(productCodeWithNameMap.get((String) productCode) + " is added because "
                                                        +productCodeWithNameMap.get($product.getProductCode()) +" in the cart");
                            }
                        }
                    }
                }
            }
        }

        if(svodProductsMaps.keySet().contains($product.getProductCode()) && !$product.getAction().equalsIgnoreCase("Remove")){
            List<String> productCodes = new ArrayList<>((List<String>) svodProductsMaps.get($product.getProductCode()));
            productCodes.removeAll(cartProductCodes);
            if(!productCodes.isEmpty() && productCodes.size() > 0){
            for (String productCode : productCodes) {
                    CartItems svodCartItem = new CartItems();
                   //System.out.println("svodCartItem ->productCode ========> "+productCode);
                    svodCartItem.setProductCode(productCode);

                    if(!"NoChange".equalsIgnoreCase($product.getAction())){
                        svodCartItem.setAction($product.getAction());
                        // set validation message
                        if("Add".equalsIgnoreCase($product.getAction())){
                            svodCartItem.setValidationMessage(productCodeWithNameMap.get((String) productCode) + " is added because "
                            +productCodeWithNameMap.get($product.getProductCode()) +" in the cart");
                        }
                    } else {
                        svodCartItem.setAction("Add");
                        svodCartItem.setValidationMessage(productCodeWithNameMap.get((String) productCode) + " is added because "
                            +productCodeWithNameMap.get($product.getProductCode()) +" in the cart");
                    }
                    if(!isProductCodeAlreadyInCartItems(cartItems, productCode)){
                        cartItems.add(svodCartItem);
                    }
                  }
            }
        }

        log.info("Finished executing rule: Cart Product SVOD service rule");
    end;

rule "Dependent Products Condition Check Specific to GENRE COHORTS"
    salience 965
    when
        CouponOffersRequest($cartContext: cartContext);
        CartContexts($cartProducts: cartProducts) from $cartContext;
        eval($cartProducts != null && !$cartProducts.isEmpty() && cartProductCodes != null && !cartProductCodes.isEmpty() && CollectionUtils.containsAny(genreSpecificRuleCohortList, contractIndicator));
    then
        log.info("Executing rule: Dependent Products Condition Check Specific to GENRE COHORTS");
        // Define the conditions in a map - Dependent Offer
        Map<String, List<String>> productConditions = productConditionsConfig;
        List<CartItems> cartItemsToRemove = new ArrayList<>();
        // Iterate over the map and apply conditions
        for (Map.Entry<String, List<String>> entry : productConditions.entrySet()) {
            String productToCheck = entry.getKey();
            List<String> requiredProducts = entry.getValue();

           //System.out.println("Checking conditions for product: " + productToCheck);
           //System.out.println("Required products: " + requiredProducts);

            boolean setAction = true;
            for (Object obj : cartItems) {
                CartItems cartItem = (CartItems) obj;
                if (requiredProducts.contains(cartItem.getProductCode()) && !"Remove".equalsIgnoreCase(cartItem.getAction())) {
                    setAction = false;
                    log.debug("Found required product in cart: " + cartItem.getProductCode());
                    break;
                }
            }

            if (setAction) {
                log.debug("Conditions not met for product: " + productToCheck + ". Setting action and validation message.");
                for (Object obj : cartItems) {
                    CartItems cartItem = (CartItems) obj;
                    if (suppressingVideoAddon && productToCheck.equalsIgnoreCase(cartItem.getProductCode())  && productCodewithTypeMap != null && !productCodewithTypeMap.isEmpty() && productCodewithTypeMap.get(productToCheck) != null && "video-addon".equalsIgnoreCase((String) productCodewithTypeMap.get(productToCheck)) && "Add".equalsIgnoreCase(cartItem.getAction())){
                       cartItemsToRemove.add(cartItem);
                    }
                    else if(productToCheck.equalsIgnoreCase(cartItem.getProductCode())) {
                        cartItem.setAction("Remove");
                        cartItem.setValidationMessage("Customer is not eligible for this offer");
                        log.debug("Set action as Remove and validation message for " + productToCheck);
                    }
                }
            } else {
                log.debug("Conditions met for product: " + productToCheck + ". No action taken.");
            }
        }

        // Remove the cartItems that are in cartItemsToRemove
        for (CartItems itemToRemove : cartItemsToRemove) {
            cartItems.remove(itemToRemove);
            log.debug("Removed cartItem: " + itemToRemove.getProductCode());
        }
        log.info("Finished executing rule: Dependent Products Condition Check Specific to GENRE COHORTS");
    end;

rule "Cart does not contain Genre Shell Base Package - services rule"
    salience 960
    when
        CouponOffersRequest($cartContext: cartContext);
        CartContexts($cartProducts: cartProducts) from $cartContext;
        eval($cartProducts != null && !$cartProducts.isEmpty() &&  cartProductCodes != null && !cartProductCodes.isEmpty() && reverseMapForSvod !=null && svodProductsMaps != null && CollectionUtils.containsAny(genreSpecificRuleCohortList, contractIndicator));
    then
        log.info("Executing rule: Cart does not contain Genre Shell Base Package - services rule");
        List<String> mapValues = getAllValuesFromMap(svodProductsMaps);
       //System.out.println("mapValues: " + mapValues);
        for (Object obj : cartItems) {
            CartItems cartItem = (CartItems) obj;
            List<String> svodPrdList = (List<String>) reverseMapForSvod.get(cartItem.getProductCode());
            if(mapValues != null && mapValues.contains(cartItem.getProductCode()) && svodPrdList != null && !CollectionUtils.containsAny(cartProductCodes, svodPrdList)){
                cartItem.setAction("Remove");
                cartItem.setValidationMessage(productCodeWithNameMap.get(cartItem.getProductCode()) + " is removed because "
                            +productCodeWithNameMap.get(getReverseMapForTemp(svodProductsMaps).get(cartItem.getProductCode()))
                            +" is not on the account or in the cart");
            }
        }
        log.info("Executing rule: Cart does not contain Genre Shell Base Package - services rule END");
    end;

