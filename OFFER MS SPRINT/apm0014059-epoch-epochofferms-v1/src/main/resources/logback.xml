<?xml version="1.0" encoding="UTF-8"?><configuration scanPeriod="5 seconds" debug="true">
 <property resource="logback-custom.properties"/>
   <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <!-- Enable the PrettyPrintingJsonGeneratorDecorator for Local development.  DO NOT add this to the ConfigRole logback.xml -->
            <!-- <jsonGeneratorDecorator class="net.logstash.logback.decorate.PrettyPrintingJsonGeneratorDecorator"/> -->
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <pattern>yyyy-MM-dd HH:mm:ss.SSS zzz</pattern>
                    <timeZone>GMT</timeZone>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <loggerName>
                    <fieldName>logger</fieldName>
                    <shortenedLoggerNameLength>25</shortenedLoggerNameLength>
                </loggerName>
                  <message class = "com.dtv.dcp.epoch.logging.LogMessageTypeProvider">
					<fieldName>msgType</fieldName>
				</message>
				<arguments class = "com.dtv.dcp.epoch.logging.LogArgumentsJsonProvider">
					<fieldName>sMsg</fieldName>
				</arguments>
              <mdc>
					<fieldName>context</fieldName>
                    <includeMdcKeyName>idp-trace-id</includeMdcKeyName>
                </mdc>
                <stackTrace>
                    <fieldName>exTrace</fieldName>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>10</maxDepthPerThrowable>
                        <rootCauseFirst>false</rootCauseFirst>
                        <maxLength>10240</maxLength>
                    </throwableConverter>
                </stackTrace>
                <stackHash>
                    <fieldName>exHash</fieldName>
                </stackHash>
                <sequence>
                    <fieldName>seq</fieldName>
                </sequence>
                <pattern><pattern>{ "format": "nf-v1.0" }</pattern></pattern>
            </providers>
        </encoder>
    </appender>
    
    <logger name="io.jaegertracing.internal.reporters" level="WARN" additivity="false">
       <appender-ref ref="STDOUT" />
    </logger>
   <logger name="com.dtv.epoch" level="DEBUG" additivity="false">
      <appender-ref ref="STDOUT"/>
   </logger>
   <root level="INFO">
      <appender-ref ref="STDOUT"/>
   </root>
</configuration>
