    for (Object objLocalOfferCode : responseLocalsOfferCodes) {
        String localOfferCode = (String) objLocalOfferCode;
        log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_SERVED_TO_UNSERVED_MARKET ::: Checking response local offer code: " + localOfferCode);
        boolean isOfferPresent = $cartOffers.stream().anyMatch(cartOffer -> localOfferCode.equals(((CartOffer) cartOffer).getOfferCode()));
        if (isOfferPresent) {
            if (localOfferCode.equalsIgnoreCase(filteredLocalBoltOn)) {
                $offerList.add(setOffer(localOfferCode, "Remove", "Customer is not eligible for this offer"));
                log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_SERVED_TO_UNSERVED_MARKET ::: Remove: " + localOfferCode);
            } else {
                $offerList.add(setOfferWithoutValidationMessage(localOfferCode, "NoChange"));
                log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_SERVED_TO_UNSERVED_MARKET ::: NoChange: " + localOfferCode);
            }
        }
    }
    List<Offer> $finalOfferList = new ArrayList<>();
        if (cartItems.size() > 0){
            for(Object obj : cartItems){
                CartItems cartItem = (CartItems) obj;
                if(cartItem.getOffers() != null && !cartItem.getOffers().isEmpty() && $offerList.size() > 0){
                    List<Offer> filterOffers = cartItem.getOffers().stream().filter(offerA -> $offerList.stream().noneMatch(offerB -> offerA.getCode().equalsIgnoreCase(offerB.getCode()))).collect(Collectors.toList());
                    log.debug("Filter Offer List: " + filterOffers);
                    $finalOfferList.addAll(filterOffers);
                    $finalOfferList.addAll($offerList);
                    cartItem.setOffers($finalOfferList);
                }else {
                    log.debug("OFFER LIST EMPTY");
                }
            }
        }else {
            log.debug("Cart Items is empty");
            cartItems.add(setCartItemsWithOfferList($offerList));
        }
        log.info("Finished executing rule: LOCALS_SALES_CUSTOMER_MOVES_FROM_SERVED_TO_UNSERVED_MARKET");
end;

rule "LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET"
salience 984
when
    $couponOffersRequest: CouponOffersRequest($cartContext: cartContext);
    $cartContexts: CartContexts($cartOffers: cartOffers) from $cartContext;
    eval($cartOffers != null && !$cartOffers.isEmpty() && responseLocalsOfferCodes != null && !responseLocalsOfferCodes.isEmpty() && isAcquisitionOfferActionType && !previousServedMarket && currentServedMarket && filteredLocalBoltOn != null)
then
    log.info("Executing rule: LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET");
    log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET ::: Cart Offers: " + $cartOffers);
    log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET ::: Response Locals Offer Codes: " + responseLocalsOfferCodes);
    List<String> $missingOffers = new ArrayList<>();
    List<Offer> $offerList = new ArrayList<>();

    for (Object objLocalOfferCode : responseLocalsOfferCodes) {
        String localOfferCode = (String) objLocalOfferCode;
        log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET ::: Checking response local offer code: " + localOfferCode);
        boolean isOfferPresent = $cartOffers.stream().anyMatch(cartOffer -> localOfferCode.equals(((CartOffer) cartOffer).getOfferCode()));
        CartOffer cartOffer = (CartOffer) $cartOffers.stream().filter(cartOffer1 -> localOfferCode.equals(((CartOffer) cartOffer1).getOfferCode())).findFirst().orElse(null);
        if (!isOfferPresent) {
            $missingOffers.add(localOfferCode);
            log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET ::: Response local offer code is not present in request cart offers: " + localOfferCode);
        } else {
            $offerList.add(setOfferWithoutValidationMessage(localOfferCode, "NoChange"));
            log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET ::: NoChange: " + localOfferCode);
        }
    }

    // Additional check for other responseLocalsOfferCodes in $cartOffers
    for (Object objLocalOfferCode : responseLocalsOfferCodes) {
        String localOfferCode = (String) objLocalOfferCode;
        boolean isOfferPresent = $cartOffers.stream().anyMatch(cartOffer -> localOfferCode.equals(((CartOffer) cartOffer).getOfferCode()));
        if (isOfferPresent && $offerList.stream().noneMatch(offer -> offer.getCode().equals(localOfferCode))) {
            $offerList.add(setOfferWithoutValidationMessage(localOfferCode, "NoChange"));
            log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET ::: Additional NoChange: " + localOfferCode);
        }
    }

    if (!$missingOffers.isEmpty() && localsZeroDollarBoltOnFlag) {
        log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET ::: Missing Offer Codes: " + $missingOffers);
        for (String missingOffer : $missingOffers) {
            $offerList.add(setOfferWithoutValidationMessage(missingOffer, "Add"));
            log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET ::: Adding missing offer to offerList: " + missingOffer);
        }
    } else if (!$missingOffers.isEmpty() && !localsZeroDollarBoltOnFlag) {
        log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET_PHASE2 :::");
        MessageDetail $messageDetail = createMessageDetail("LOCALS_ELIGIBLE", "Customer is eligible for Locals", "Information");
        messageDetails.add($messageDetail);
    }
    List<Offer> $finalOfferList = new ArrayList<>();
    if (cartItems.size() > 0) {
        for (Object obj : cartItems) {
            CartItems cartItem = (CartItems) obj;
            if (cartItem.getOffers() != null && !cartItem.getOffers().isEmpty() && $offerList.size() > 0) {
                List<Offer> filterOffers = cartItem.getOffers().stream().filter(offerA -> $offerList.stream().noneMatch(offerB -> offerA.getCode().equalsIgnoreCase(offerB.getCode()))).collect(Collectors.toList());
                log.debug("Filter Offer List: " + filterOffers);
                $finalOfferList.addAll(filterOffers);
                $finalOfferList.addAll($offerList);
                cartItem.setOffers($finalOfferList);
            } else {
                log.debug("OFFER LIST EMPTY");
            }
        }
    } else {
        log.debug("Cart Items is empty");
        cartItems.add(setCartItemsWithOfferList($offerList));
    }
    log.info("Finished executing rule: LOCALS_SALES_CUSTOMER_MOVES_FROM_UNSERVED_TO_SERVED_MARKET");
end;

