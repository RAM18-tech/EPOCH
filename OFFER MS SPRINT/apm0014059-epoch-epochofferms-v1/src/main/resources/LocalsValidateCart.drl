global java.util.ArrayList cartItems;
global java.util.ArrayList messageDetails;
global java.util.ArrayList requestCartOfferCodes;
global java.util.ArrayList responseLocalsOfferCodes;
global java.lang.String localsBoltOnProductSKU;
global java.lang.String filteredLocalBoltOn;
global java.lang.Boolean currentServedMarket;
global java.lang.Boolean previousServedMarket;
global java.lang.Boolean localsZeroDollarBoltOnFlag;
global java.lang.Boolean isAcquisitionOfferActionType;
global java.lang.String ctOfferResponseOfferCode;
global java.util.ArrayList preSelectAndDispIncludedAndFeeTypeCodes;
global java.util.ArrayList cartCallOfferCodes;
global java.lang.Boolean genericRulesExecutionFlag;
global java.util.ArrayList requestCustomerContextOTTProducts;
global java.util.ArrayList requestCartProductCodes;
global Logger log;

rule "Generic Rule 1"
salience 1002
    when
       CouponOffersRequest($cartContext: cartContext);
       CartContexts($cartOffers: cartOffers) from $cartContext;
       eval($cartOffers != null && !$cartOffers.isEmpty() && genericRulesExecutionFlag)
    then
        log.info("Executing Generic Rule 1");
        List<Offer> $offerList = new ArrayList<>();
        for (Object obj : $cartOffers) {
            CartOffer cartOffer = (CartOffer) obj;
            if(ctOfferResponseOfferCode ==null || (cartOffer.getOfferProductType() != null && cartOffer.getOfferProductType().equalsIgnoreCase("video-plan") && ctOfferResponseOfferCode !=null && ctOfferResponseOfferCode.equalsIgnoreCase(cartOffer.getOfferCode()))){
              $offerList.add(setOffer(cartOffer.getOfferCode(),"NoChange", null));
            }else if(cartOffer.getOfferProductType() != null && cartOffer.getOfferProductType().equalsIgnoreCase("video-plan") && ctOfferResponseOfferCode !=null && !ctOfferResponseOfferCode.equalsIgnoreCase(cartOffer.getOfferCode())){
              $offerList.add(setOffer(cartOffer.getOfferCode(),"Remove", null));
              $offerList.add(setOffer(ctOfferResponseOfferCode, "Add", null));
            }
        }
    List<Offer> $finalOfferList = new ArrayList<>();
        log.debug("Cart Items size: " + cartItems.size());
        log.debug("Offer List size: " + $offerList.size());
        if (cartItems.size() > 0 && $offerList.size() > 0){
            for(Object obj : cartItems){
                CartItems cartItem = (CartItems) obj;
                if(cartItem.getOffers() != null && !cartItem.getOffers().isEmpty()){
                    List<Offer> filterOffers = cartItem.getOffers().stream().filter(offerA -> $offerList.stream().noneMatch(offerB -> offerA.getCode().equalsIgnoreCase(offerB.getCode()))).collect(Collectors.toList());
                    $finalOfferList.addAll(filterOffers);
                    $finalOfferList.addAll($offerList);
                    cartItem.setOffers($finalOfferList);
                }
            }
        }else {
            log.debug("Cart Items size: " + cartItems.size());
            log.debug("Offer List size: " + $offerList.size());
            cartItems.add(setCartItemsWithOfferList($offerList));
        }
        log.info("Finished executing Generic Rule 1");
    end;


rule "Generic Rule 2"
salience 1001
    when
       CouponOffersRequest($cartContext: cartContext);
       CartContexts($cartOffers: cartOffers) from $cartContext;
       eval($cartOffers != null && !$cartOffers.isEmpty() && genericRulesExecutionFlag)
    then
        log.info("Executing Generic Rule 2");
        List<Offer> $offerList = new ArrayList<>();
        List<Offer> $preSelectOffer = new ArrayList<>();
        for (Object obj : $cartOffers) {
            CartOffer cartOffer = (CartOffer) obj;
            if(cartCallOfferCodes != null && cartCallOfferCodes.contains(cartOffer.getOfferCode()) && cartOffer.getOfferProductType() != null && !cartOffer.getOfferProductType().equalsIgnoreCase("video-plan")){
              $offerList.add(setOffer(cartOffer.getOfferCode(), "NoChange", null));
            }else if(cartOffer.getOfferProductType() != null && !cartOffer.getOfferProductType().equalsIgnoreCase("video-plan")){
              $offerList.add(setOffer(cartOffer.getOfferCode(), "Remove", "Customer is not eligible for this offer"));
            }
        }
        //Adding preSelectAndDispIncludedAndFeeTypeCodes to $preSelectOffer
        for(Object obj : preSelectAndDispIncludedAndFeeTypeCodes){
            String preSelect = (String) obj;
            if($offerList != null && !$offerList.isEmpty()){
                if($offerList.stream().noneMatch(offer -> offer.getCode().equalsIgnoreCase(preSelect))){
                    $preSelectOffer.add(setOffer(preSelect, "Add", null));
                }
            } else{
                $preSelectOffer.add(setOffer(preSelect, "Add", null));
            }
        }
        log.debug("Cart Items size: " + cartItems.size());
        log.debug("Offer List size: " + $offerList.size());
    List<Offer> $finalOfferList = new ArrayList<>();
        if (cartItems.size() > 0){
            for(Object obj : cartItems){
                CartItems cartItem = (CartItems) obj;
                if(cartItem.getOffers() != null && !cartItem.getOffers().isEmpty() && $offerList != null && !$offerList.isEmpty()){
                    List<Offer> filterOffers = cartItem.getOffers().stream().filter(offerA -> $offerList.stream().noneMatch(offerB -> offerA.getCode().equalsIgnoreCase(offerB.getCode()))).collect(Collectors.toList());
                    $finalOfferList.addAll(filterOffers);
                    $finalOfferList.addAll($offerList);
                    if($preSelectOffer != null && !$preSelectOffer.isEmpty()){
                        $finalOfferList.addAll($preSelectOffer);
                    }
                    cartItem.setOffers($finalOfferList);
                }else if($preSelectOffer != null && !$preSelectOffer.isEmpty()){
                    log.info("Adding preSelectOffer to CartItems");
                    cartItem.setOffers($preSelectOffer);
                }
            }
        }else {
            log.debug("Cart Items size: " + cartItems.size());
            cartItems.add(setCartItemsWithOfferList($offerList));
        }
        log.info("Finished executing Generic Rule 2");
end;

function MessageDetail createMessageDetail(String messageCode, String messageText, String messageSeverity) {
    MessageDetail messageDetail = new MessageDetail();
    messageDetail.setMessageText(messageText);
    messageDetail.setMessageSeverity(messageSeverity);
    messageDetail.setMessageCode(messageCode);
    return messageDetail;
}

function CartItems setCartItems(String sku, String action, String promoId, String promoAction) {
    CartItems $cartItem = new CartItems();
    $cartItem.setProductCode(sku);
    $cartItem.setAction(action);
    if(promoId != null && promoAction != null){
        $cartItem.setPromotions(new ArrayList<>());
        $cartItem.getPromotions().add(setPromotion(promoId, promoAction));
    }
    return $cartItem;
}

function CartItems setCartItemsWithOffers(String code, String action, String validationMessage) {
    CartItems $cartItem = new CartItems();
    if(code != null && action != null){
        $cartItem.setOffers(new ArrayList<>());
        $cartItem.getOffers().add(setOffer(code, action, validationMessage));
    }
    return $cartItem;
}

function CartItems setCartItemsWithOfferList(List offerList) {
    CartItems $cartItem = new CartItems();
    if(offerList != null && !offerList.isEmpty()){
    $cartItem.setOffers(offerList);
    }
    return $cartItem;
}

function CartItems setCartItemsWithMultiPromo(String sku, String action, String promoId, String promoAction, String promoId2, String promoAction2) {
    CartItems $cartItem = new CartItems();
    $cartItem.setProductCode(sku);
    $cartItem.setAction(action);
    if(promoId != null && promoAction != null){
        $cartItem.setPromotions(new ArrayList<>());
        $cartItem.getPromotions().add(setPromotion(promoId, promoAction));
    }

    if(promoId2 != null && promoAction2 != null){
        $cartItem.getPromotions().add(setPromotion(promoId2, promoAction2));
    }
    return $cartItem;
}

function Promotion setPromotion(String promoId, String action) {
    Promotion $promo = new Promotion();
    $promo.setPromotionId(promoId);
    $promo.setAction(action);
    return $promo;
}

function Offer setOffer(String code, String action, String validationMessage) {
    Offer $offer = new Offer();
    $offer.setCode(code);
    $offer.setAction(action);
    $offer.setValidationMessage(validationMessage);
    return $offer;
}
function Offer setOfferWithoutValidationMessage(String code, String action) {
    Offer $offer = new Offer();
    $offer.setCode(code);
    $offer.setAction(action);
    return $offer;
}

rule "LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET"
salience 986
when
    $couponOffersRequest: CouponOffersRequest($cartContext: cartContext);
    $cartContexts: CartContexts($cartOffers: cartOffers) from $cartContext;
    eval($cartOffers != null && !$cartOffers.isEmpty() && responseLocalsOfferCodes != null && !responseLocalsOfferCodes.isEmpty() && isAcquisitionOfferActionType && previousServedMarket && currentServedMarket && localsZeroDollarBoltOnFlag)
then
    log.info("Executing rule: LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET");
    log.debug("LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: Cart Offers: " + $cartOffers);
    log.debug("LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: Response Locals Offer Codes: " + responseLocalsOfferCodes);
    List<String> $missingOffers = new ArrayList<>();
    List<Offer> $offerList = new ArrayList<>();

    for (Object objLocalOfferCode : responseLocalsOfferCodes) {
        String localOfferCode = (String) objLocalOfferCode;
        log.debug("LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: Checking response local offer code: " + localOfferCode);
        boolean isOfferPresent = $cartOffers.stream().anyMatch(cartOffer -> localOfferCode.equals(((CartOffer) cartOffer).getOfferCode()));
        if (!isOfferPresent) {
            $missingOffers.add(localOfferCode);
            log.debug("LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: Response local offer code is not present in request cart offers: " + localOfferCode);
        } else {
            $offerList.add(setOfferWithoutValidationMessage(localOfferCode, "NoChange"));
            log.debug("LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: NoChange: " + localOfferCode);
        }
    }

    if (!$missingOffers.isEmpty()) {
        log.debug("LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: Missing Offer Codes: " + $missingOffers.toString());
        for (String missingOffer : $missingOffers) {
            $offerList.add(setOfferWithoutValidationMessage(missingOffer, "Add"));
            log.debug("LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: Adding missing offer to offerList: " + missingOffer);
        }
    }
    List<Offer> $finalOfferList = new ArrayList<>();
        if (cartItems.size() > 0){
            for(Object obj : cartItems){
                CartItems cartItem = (CartItems) obj;
                if(cartItem.getOffers() != null && !cartItem.getOffers().isEmpty() && $offerList.size() > 0){
                    List<Offer> filterOffers = cartItem.getOffers().stream().filter(offerA -> $offerList.stream().noneMatch(offerB -> offerA.getCode().equalsIgnoreCase(offerB.getCode()))).collect(Collectors.toList());
                    log.debug("Filter Offer List: " + filterOffers);
                    $finalOfferList.addAll(filterOffers);
                    $finalOfferList.addAll($offerList);
                    cartItem.setOffers($finalOfferList);
                }else{
                    log.debug("OFFER LIST EMPTY");
                }
            }
        }else {
            log.debug("Cart Items is empty");
            cartItems.add(setCartItemsWithOfferList($offerList));
        }
        log.info("Finished executing rule: LOCALS_SALES_CUSTOMER_REMAINS_IN_SERVED_MARKET");
end;

rule "LOCALS_SALES_CUSTOMER_MOVES_FROM_SERVED_TO_UNSERVED_MARKET"
salience 985
when
    $couponOffersRequest: CouponOffersRequest($cartContext: cartContext);
    $cartContexts: CartContexts($cartOffers: cartOffers) from $cartContext;
    eval($cartOffers != null && !$cartOffers.isEmpty() && responseLocalsOfferCodes != null && !responseLocalsOfferCodes.isEmpty() && isAcquisitionOfferActionType && previousServedMarket && !currentServedMarket && localsZeroDollarBoltOnFlag && filteredLocalBoltOn != null)
then
    log.info("Executing rule: LOCALS_SALES_CUSTOMER_MOVES_FROM_SERVED_TO_UNSERVED_MARKET");
    log.debug("LOCALS_SALES_CUSTOMER_MOVES_FROM_SERVED_TO_UNSERVED_MARKET ::: Cart Offers: " + $cartOffers);
