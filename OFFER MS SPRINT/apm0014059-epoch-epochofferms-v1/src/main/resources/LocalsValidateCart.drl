rule "LOCALS_SERVICES_CUSTOMER_REMAINS_IN_SERVED_MARKET"
salience 982
when
    $couponOffersRequest: CouponOffersRequest($cartContext: cartContext);
    $cartContexts: CartContexts($cartProducts: cartProducts) from $cartContext;
    eval($cartProducts != null && !$cartProducts.isEmpty() && requestCustomerContextOTTProducts != null && !requestCustomerContextOTTProducts.isEmpty() && !isAcquisitionOfferActionType && previousServedMarket && currentServedMarket)
then
    log.info("Executing rule: LOCALS_SERVICES_CUSTOMER_REMAINS_IN_SERVED_MARKET");
    log.debug("LOCALS_SERVICES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: Cart Products: " + $cartProducts);
    log.debug("LOCALS_SERVICES_CUSTOMER_REMAINS_IN_SERVED_MARKET ::: Filtered Local Bolt On: " + filteredLocalBoltOn);

    if (localsZeroDollarBoltOnFlag && filteredLocalBoltOn != null) {
        boolean isBoltOnLocalProductPresent = false;
        Set<String> existingProductCodes = new HashSet<>();

        for (Object obj : $cartProducts) {
            CartProduct cartProduct = (CartProduct) obj;
            existingProductCodes.add(cartProduct.getProductCode());

            CartItems $cartItem = new CartItems();
            $cartItem.setProductCode(cartProduct.getProductCode());
            if (cartProduct.getPromotions() != null) {
                setPromos(cartProduct, $cartItem);
            }
            if (filteredLocalBoltOn.equalsIgnoreCase(cartProduct.getProductCode()) && "Remove".equalsIgnoreCase(cartProduct.getAction())) {
                $cartItem.setAction("Add");
                isBoltOnLocalProductPresent = true;
            } else {
                $cartItem.setAction(cartProduct.getAction());
            }

            if (!existingProductCodes.contains($cartItem.getProductCode())) {
                cartItems.add($cartItem);
                existingProductCodes.add($cartItem.getProductCode());
                log.debug("Adding product with action '" + $cartItem.getAction() + "': " + cartProduct.getProductCode());
            } else {
                // Update the action to "Add" if the product code already exists and the action is "Remove"
                for (Object itemObj : cartItems) {
